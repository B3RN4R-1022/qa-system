generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")    // Transaction Pooler (6543) — para queries em runtime
  directUrl = env("DIRECT_URL")      // Session Pooler (5432) — para migrations
}

model QATask {
  id          String   @id @default(cuid())
  asanaId     String   @unique
  title       String
  description String?
  previewUrl  String?
  assignee      String?
  assigneeEmail String?
  status             String   @default("pending")
  projectName        String?
  wasRejectedBefore  Boolean  @default(false)
  wasSuggestedBefore Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  checks      QACheck[]
  comments    QAComment[]
}

model QACheck {
  id      String  @id @default(cuid())
  taskId  String
  task    QATask  @relation(fields: [taskId], references: [id])
  label   String
  checked Boolean @default(false)
}

model QAComment {
  id        String   @id @default(cuid())
  taskId    String
  task      QATask   @relation(fields: [taskId], references: [id])
  type      String   // 'rejected' | 'suggested' | 'approved'
  text      String
  createdAt DateTime @default(now())
}

model QAEvent {
  id               String   @id @default(cuid())
  asanaId          String   // GID da task no Asana — permite deduplicar por task
  action           String   // 'approved' | 'rejected' | 'suggested'
  projectName      String?
  assignee         String?
  wasFirstApproval Boolean  @default(false)
  createdAt        DateTime @default(now())
}

model User {
  id          String     @id @default(uuid())
  name        String
  email       String     @unique
  password    String
  role        String     @default("qa")  // 'qa' | 'dev' | 'admin'
  totpSecret  String?
  createdAt   DateTime   @default(now())
  devTests    DevTest[]
  aiReports   AIReport[]
}

model DevTest {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  title       String
  description String
  previewUrl  String
  projectName String?
  criteria    String?  // JSON: ["critério 1", "critério 2"]
  status      String   @default("queued")  // 'queued' | 'running' | 'done' | 'error'
  report      String?
  tokensUsed  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String   @default("legacy")  // histórico por usuário
  role      String   // 'user' | 'assistant'
  content   String
  createdAt DateTime @default(now())
}

model AIReport {
  id         String   @id @default(cuid())
  taskId     String   @unique
  sessionId  String?
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  status     String   @default("pending") // 'pending' | 'running' | 'done' | 'error'
  report     String?
  tokensUsed Int?     // tokens consumidos nesta execução
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AIKnowledge {
  id        String   @id @default(cuid())
  type      String   // 'skill' | 'project'
  name      String   // nome da skill ou do projeto
  content   String   // conteúdo da base de conhecimento
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, name])
}

model ProjectToolCall {
  id          String   @id @default(cuid())
  projectName String
  topic       String   // ex: "auth/login", "products/create"
  title       String   // ex: "Login com Email e Senha"
  description String   @default("") // resumo curto (1 frase) para busca
  content     String   // detalhes relevantes para QA (endpoints, campos, regras)
  source      String   @default("") // arquivo de origem ex: "src/auth/loginService.js"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectName, topic])
  @@index([projectName])
}