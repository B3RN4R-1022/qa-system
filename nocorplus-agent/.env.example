# URL do backend QA System
# Produção (padrão):
BACKEND_URL=https://qa-system-5vpf.onrender.com
# Local (desenvolvimento):
# BACKEND_URL=http://localhost:3000

# Chave do provedor de IA — configure UMA das duas:
# Claude (padrão — usa Sonnet para planejar, Haiku para Vision)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (alternativa — gpt-4o-mini, ~20x mais barato que Sonnet)
# OPENAI_API_KEY=sk-...

# Caminho para o código-fonte do projeto testado (opcional mas recomendado)
# Ativa as code tools: o LLM usa seletores reais dos componentes React/Vue
# em vez de adivinhar pelo DOM — melhora muito a precisão
# Exemplo: SRC_ROOT=C:\projetos\meu-app\src
SRC_ROOT=

# Credenciais de login padrão para jobs qa_task (sem login_email no payload)
# Usado como fallback quando o job não traz email/senha próprios
QA_LOGIN_EMAIL=
QA_LOGIN_PASSWORD=
